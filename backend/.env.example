# Application
APP_NAME=MedVault API
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# MongoDB
MONGODB_URI=<YOUR_MONGODB_CONNECTION_URI>
MONGODB_DB_NAME=medvault

# Authentication (replace with a cryptographically random value of at least 32 bytes)
JWT_SECRET=<YOUR_SECURE_RANDOM_JWT_SECRET>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional Mistral ambiguity resolver
MISTRAL_API_KEY=<YOUR_MISTRAL_API_KEY_OR_LEAVE_EMPTY>
MISTRAL_MODEL=mistral-small-latest

# Optional browser Web Push
VAPID_PUBLIC_KEY=<YOUR_VAPID_PUBLIC_KEY_OR_LEAVE_EMPTY>
VAPID_PRIVATE_KEY=<YOUR_VAPID_PRIVATE_KEY_OR_LEAVE_EMPTY>
VAPID_SUBJECT=<YOUR_CONTACT_EMAIL_AS_MAILTO_URI>

# Optional SMTP fallback
SMTP_HOST=<YOUR_SMTP_HOST_OR_LEAVE_EMPTY>
SMTP_PORT=587
SMTP_USER=<YOUR_SMTP_USERNAME_OR_LEAVE_EMPTY>
SMTP_PASS=<YOUR_SMTP_PASSWORD_OR_LEAVE_EMPTY>
SMTP_FROM_EMAIL=<YOUR_SMTP_SENDER_EMAIL_OR_LEAVE_EMPTY>
SMTP_USE_TLS=true
# Public frontend origin used in secure-share emails. Use your deployed HTTPS URL outside local development.
FRONTEND_PUBLIC_URL=http://127.0.0.1:5173

# Ephemeral document storage
TEMP_JOB_DIR=./.medvault_jobs
TEMP_JOB_TTL_SECONDS=3600
TEMP_CLEANUP_INTERVAL_SECONDS=300
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_BATCH_FILES=25
MAX_CONCURRENT_CHUNKS=4

# Local OCR executable override; leave blank when tesseract is on PATH
TESSERACT_CMD=<YOUR_TESSERACT_EXECUTABLE_PATH_OR_LEAVE_EMPTY>
